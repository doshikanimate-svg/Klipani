{
  "appId": "com.klipani.app",
  "productName": "KLIPANI",
  "copyright": "Copyright © 2026 KLIPANI",
  "directories": {
    "output": "release"
  },
  "publish": {
    "provider": "github",
    "owner": "doshikanimate-svg",
    "repo": "klipani"
  },
  "files": [
    "electron/main.js",
    "electron/icon.icns",
    "frontend/.next/standalone/**/*"
  ],
  "extraResources": [
    {
      "from": "build/dist/klipani-backend",
      "to": "klipani-backend"
    }
  ],
  "mac": {
    "category": "public.app-category.video",
    "icon": "electron/icon.icns",
    "target": ["dmg", "zip"]
  },
  "win": {
    "icon": "electron/icon.ico",
    "target": ["nsis"],
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "electron/icon.ico",
    "uninstallerIcon": "electron/icon.ico"
  }
}
