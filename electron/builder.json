{
  "appId": "com.klipani.app",
  "productName": "KLIPANI",
  "copyright": "Copyright © 2026 KLIPANI",
  "directories": {
    "output": "release"
  },
  "files": [
    "electron/main.js",
    "electron/icon.icns",
    "frontend/.next/standalone/**/*"
  ],
  "extraResources": [
    {
      "from": "build/dist/klipani-backend",
      "to": "klipani-backend"
    }
  ],
  "mac": {
    "category": "public.app-category.video",
    "icon": "electron/icon.icns",
    "target": ["dmg", "zip"]
  },
  "win": {
    "target": ["nsis"]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
